# ALPAS Trader Capital — environment variables
# Copy to .env.local. Never commit real values; .env* files are git-ignored.
#
# Nothing here is required. Without these variables the app runs fully in demo
# mode and the Assistant is labelled "Demo: rule-based answers".

# ── ALPAS Assistant: optional language-model wording (server-side only) ──
# The key is read only by the /api/assistant route handler and is never sent to
# the browser. Answers stay grounded: the deterministic engine produces the
# draft, numbers and sources; the model may only rephrase, and every rewrite is
# validated (no new numbers, account ids or sources) before it is shown.
ANTHROPIC_API_KEY=

# anthropic | none  (default: anthropic when ANTHROPIC_API_KEY is set)
ALPAS_LLM_PROVIDER=anthropic

# Model id used for rewriting (default: claude-opus-5-5)
ALPAS_LLM_MODEL=claude-opus-5-5

# low | medium | high — effort for the short rewriting task (default: low)
ALPAS_LLM_EFFORT=low
